#!/bin/sh
# simple pre-commit hook: run quick tests
if command -v poetry > /dev/null 2>&1; then
    poetry run pytest -q || exit 1
elif [ -f "venv/Scripts/pytest" ]; then
    PYTHONPATH=src venv/Scripts/pytest -q || exit 1
elif [ -f "venv/bin/pytest" ]; then
    PYTHONPATH=src venv/bin/pytest -q || exit 1
else
    PYTHONPATH=src pytest -q || exit 1
fi
